# ──────────────────────────────────────────────────────────────────────────
# Relax Station Client — Environment Variables
# These are baked into the JS bundle at BUILD TIME by Vite.
# Copy to .env for local dev. Set in Netlify dashboard for production.
# NEVER commit .env.
# ──────────────────────────────────────────────────────────────────────────

# ── API base URL ──────────────────────────────────────────────────────────
# Local dev:   http://localhost:5000/api
# Production:  https://relax-station-api.onrender.com/api  (your Render URL)
VITE_API_URL=http://localhost:5000/api

# ── Sentry (optional) ─────────────────────────────────────────────────────
VITE_SENTRY_DSN=
