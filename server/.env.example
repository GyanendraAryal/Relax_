# ──────────────────────────────────────────────────────────────────────────
# Relax Station API — Environment Variables
# Copy to .env for local development. NEVER commit .env.
# In production (Render), set these in the dashboard Environment section.
# ──────────────────────────────────────────────────────────────────────────

NODE_ENV=production
# PORT is injected automatically by Render. For local dev, use 5000.
PORT=5000

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated frontend origins — no trailing slashes.
# Local:  http://localhost:5173,http://localhost:5174
# Prod:   https://your-site.netlify.app,https://relaxstation.np
CLIENT_URLS=https://your-site.netlify.app

# ── Database ──────────────────────────────────────────────────────────────
# Neon (production):  postgresql://user:pass@host/db?sslmode=require
# Local Docker:       postgres://relax_station:relax_station_secret@localhost:5432/relax_station
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────
# Must be 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-secure-random-string-minimum-32-characters
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=relax_station_token

# ── Redis (optional) ──────────────────────────────────────────────────────
# Leave REDIS_ENABLED=false for single-instance deploys on Render free tier.
# Enable only if you add a Redis service.
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ── Cloudinary (required for image uploads) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Sentry (optional) ─────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
